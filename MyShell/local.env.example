# MyShell/local.env —— 本机差异配置
# 用法: 复制本文件为 MyShell/local.env（已 gitignore），取消注释并修改需要的项
# local.env 由 env.sh 自动 source，修改后下次启动脚本即生效

# Redis 候选主机（空格分隔、按序探测）
# REDIS_CANDIDATES="127.0.0.1 192.168.1.100"
# REDIS_PORT=6379

# MySQL
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=neko
# MYSQL_PWD=neko123456
# MYSQL_DB=search_house

# 其他依赖
# CONSUL_HTTP=http://127.0.0.1:8500
# MINIO_API=http://127.0.0.1:9000
# AMQP_HOST=127.0.0.1
# AMQP_PORT=5672

# Go（go 不在 PATH 时指定）
# GO_BIN=/usr/local/go/bin/go

# docker 容器名
# DOCKER_CONTAINER_REDIS=ihome-redis
# DOCKER_CONTAINER_MYSQL=ihome-mysql